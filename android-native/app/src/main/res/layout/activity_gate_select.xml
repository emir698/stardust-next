<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bu cihaz hangi kapı?"
        android:textColor="@color/textPrimary"
        android:textSize="19sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bu seçim cihazda hatırlanır, istediğin zaman değiştirebilirsin."
        android:textColor="@color/textFaint"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginBottom="36dp" />

    <LinearLayout
        android:id="@+id/genelCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="24dp"
        android:layout_marginBottom="14dp"
        android:clickable="true"
        android:focusable="true">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ön Giriş"
            android:textColor="@color/textPrimary"
            android:textSize="22sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Genel Alan Girişi"
            android:textColor="@color/textFaint"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ormanCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_green"
        android:padding="24dp"
        android:clickable="true"
        android:focusable="true">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Giriş"
            android:textColor="@color/accentOrmanDark"
            android:textSize="22sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Orman Girişi (önce ön giriş şart)"
            android:textColor="@color/accentOrmanDark"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
