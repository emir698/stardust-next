<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp">

            <Button
                android:id="@+id/backButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:text="← Geri"
                android:textAllCaps="false"
                android:textColor="@color/textMuted"
                android:textSize="13sp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="0dp"
                android:elevation="0dp"
                android:stateListAnimator="@null" />

            <TextView
                android:id="@+id/seansLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/textPrimary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/statPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/textMuted"
                android:textSize="11sp"
                android:fontFamily="monospace" />

            <Button
                android:id="@+id/listeButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_dark"
                android:text="☰ Liste"
                android:textAllCaps="false"
                android:textColor="@color/textPrimary"
                android:textSize="12sp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:elevation="0dp"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Honeywell / manual barcode input -->
            <EditText
                android:id="@+id/barcodeInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_input"
                android:hint="👆 Barkod okut veya buraya yaz"
                android:textColorHint="@color/textDim"
                android:textColor="@color/textPrimary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:gravity="center"
                android:padding="16dp"
                android:singleLine="true"
                android:inputType="textVisiblePassword|textCapCharacters"
                android:imeOptions="actionDone" />

            <!-- QR camera card -->
            <FrameLayout
                android:id="@+id/qrCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:layout_marginBottom="16dp">

                <androidx.camera.view.PreviewView
                    android:id="@+id/cameraPreview"
                    android:layout_width="match_parent"
                    android:layout_height="320dp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/qrStartButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:text="📷"
                    android:textSize="32sp"
                    android:padding="14dp"
                    android:elevation="0dp"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/qrStopButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_button_light"
                    android:text="⏹ Kamerayı Durdur"
                    android:textAllCaps="false"
                    android:textColor="@color/bg"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:padding="16dp"
                    android:visibility="gone"
                    android:elevation="0dp"
                    android:stateListAnimator="@null" />
            </FrameLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- Toast -->
    <TextView
        android:id="@+id/toastText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_toast"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:textColor="@color/textPrimary"
        android:textSize="13sp"
        android:visibility="gone" />

</FrameLayout>
